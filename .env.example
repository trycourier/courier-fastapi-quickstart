# Your Courier API key, from https://app.courier.com/settings/api-keys
# Copy this file to .env and paste your key in.
COURIER_API_KEY=YOUR_COURIER_API_KEY

# Where the demo user's notifications go, by email and in the Courier inbox.
# On a Test key, use the email you signed up to Courier with: the built-in
# test email provider delivers only to members of your workspace.
DEMO_EMAIL=YOUR_EMAIL
